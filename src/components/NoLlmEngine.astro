---
---

<section id="engine" class="py-16 md:py-24 border-b border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#0c0c0c] relative transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="font-mono text-xs font-semibold tracking-widest text-[#525252] dark:text-[#a1a1a1] uppercase">
        ARCHITECTURAL ADVANTAGE • ZERO TOKEN BILLS
      </div>
      <h2 class="text-3xl md:text-5xl font-semibold text-[#171717] dark:text-white tracking-tight">
        How We Eliminate Paid API Keys Completely
      </h2>
      <p class="text-[#4d4d4d] dark:text-[#a1a1a1] text-base sm:text-lg font-normal">
        Most AI video tools force you to connect expensive OpenAI and ElevenLabs keys. Instant Shorts AI uses a zero-cost local & open stack so you can generate unlimited shorts for free.
      </p>
    </div>

    <!-- 4-Column Architectural Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Card 1 -->
      <div class="bg-white dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] shadow-xs flex flex-col justify-between hover:border-neutral-400 dark:hover:border-neutral-600 transition-all group">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-violet-100 dark:bg-violet-950/80 text-violet-800 dark:text-violet-300 flex items-center justify-center font-mono font-bold text-sm">
            01
          </div>
          <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-violet-700 dark:group-hover:text-violet-400 transition-colors">
            In-Browser Web-LLM
          </h3>
          <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            Uses WebGPU to run quantized Llama & Qwen models right inside your web browser. Zero server API calls, zero latency, 100% private script generation.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between text-[11px] font-mono text-[#525252] dark:text-[#888888]">
          <span>Engine: WebGPU / WASM</span>
          <span class="text-emerald-700 dark:text-emerald-400 font-semibold">$0.00 / script</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-white dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] shadow-xs flex flex-col justify-between hover:border-neutral-400 dark:hover:border-neutral-600 transition-all group">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-cyan-100 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-300 flex items-center justify-center font-mono font-bold text-sm">
            02
          </div>
          <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-cyan-700 dark:group-hover:text-cyan-400 transition-colors">
            Native Speech Synthesis
          </h3>
          <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            Leverages W3C Web Speech API alongside open-source HuggingFace neural voice synthesis. No $0.30/min ElevenLabs character billing.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between text-[11px] font-mono text-[#525252] dark:text-[#888888]">
          <span>Engine: Web Speech API</span>
          <span class="text-emerald-700 dark:text-emerald-400 font-semibold">Unlimited Voice</span>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-white dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] shadow-xs flex flex-col justify-between hover:border-neutral-400 dark:hover:border-neutral-600 transition-all group">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 flex items-center justify-center font-mono font-bold text-sm">
            03
          </div>
          <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
            Open 9:16 Footage Vault
          </h3>
          <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            Pre-indexed library of royalty-free ASMR, Minecraft parkour, GTA stunts, space loops, and custom video upload with automatic keyword placement.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between text-[11px] font-mono text-[#525252] dark:text-[#888888]">
          <span>Library: 50,000+ Clips</span>
          <span class="text-emerald-700 dark:text-emerald-400 font-semibold">Commercial Safe</span>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="bg-white dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] shadow-xs flex flex-col justify-between hover:border-neutral-400 dark:hover:border-neutral-600 transition-all group">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 flex items-center justify-center font-mono font-bold text-sm">
            04
          </div>
          <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors">
            BYOK (Bring Your Key)
          </h3>
          <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            Prefer OpenAI, Groq, or Claude? Easily plug in your own API key anytime. You retain total ownership with zero markup or middleman fees.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between text-[11px] font-mono text-[#525252] dark:text-[#888888]">
          <span>Support: Groq, OpenAI, Ollama</span>
          <span class="text-neutral-700 dark:text-neutral-300 font-semibold">Optional</span>
        </div>
      </div>

    </div>

    <!-- Architecture Code Block -->
    <div class="mt-12 bg-white dark:bg-[#111111] rounded-2xl border border-[#ebebeb] dark:border-[#262626] p-6 shadow-sm">
      <div class="flex items-center justify-between pb-4 border-b border-[#ebebeb] dark:border-[#262626] font-mono text-xs text-[#525252] dark:text-[#a1a1a1]">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-400"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
          <span class="w-3 h-3 rounded-full bg-green-400"></span>
          <span class="ml-2 text-[#171717] dark:text-white font-semibold">instant-shorts-pipeline.ts</span>
        </div>
        <div>No-LLM Client Architecture</div>
      </div>

      <pre class="pt-4 font-mono text-xs text-[#171717] dark:text-[#ededed] leading-relaxed overflow-x-auto"><code is:raw><span class="text-purple-600 dark:text-purple-400">import</span> { WebLLM, WebSpeechVoice, CanvasRenderer } <span class="text-purple-600 dark:text-purple-400">from</span> <span class="text-emerald-700 dark:text-emerald-400">'@instantshorts/core'</span>;

<span class="text-neutral-400">// Initialize client-side pipeline with ZERO external paid tokens</span>
<span class="text-purple-600 dark:text-purple-400">const</span> pipeline = <span class="text-blue-600 dark:text-blue-400">new</span> ShortGenerator({
  scriptEngine: <span class="text-emerald-700 dark:text-emerald-400">'web-llm'</span>,        <span class="text-neutral-400">// Runs in WebGPU locally</span>
  ttsEngine: <span class="text-emerald-700 dark:text-emerald-400">'web-speech'</span>,       <span class="text-neutral-400">// Browser speech synthesis</span>
  subtitleStyle: <span class="text-emerald-700 dark:text-emerald-400">'mrbeast-yellow'</span>, <span class="text-neutral-400">// Word-by-word active highlight</span>
  aspectRatio: <span class="text-emerald-700 dark:text-emerald-400">'9:16'</span>
});

<span class="text-purple-600 dark:text-purple-400">const</span> short = <span class="text-purple-600 dark:text-purple-400">await</span> pipeline.generate({ topic: <span class="text-emerald-700 dark:text-emerald-400">'Stoic Philosophy'</span> });
<span class="text-purple-600 dark:text-purple-400">console</span>.log(<span class="text-emerald-700 dark:text-emerald-400">`Generated ${short.duration}s MP4 video with $0 API overhead!`</span>);</code></pre>
    </div>

  </div>
</section>
