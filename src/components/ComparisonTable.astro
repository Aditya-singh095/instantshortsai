---
---

<section class="py-16 md:py-24 border-b border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#080808] relative transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="font-mono text-xs font-semibold tracking-widest text-[#525252] dark:text-[#a1a1a1] uppercase">
        TRANSPARENT COMPARISON
      </div>
      <h2 class="text-3xl md:text-5xl font-semibold text-[#171717] dark:text-white tracking-tight">
        Why Creators Choose Instant Shorts AI
      </h2>
      <p class="text-[#4d4d4d] dark:text-[#a1a1a1] text-base sm:text-lg font-normal">
        Compare our open-stack architecture against traditional paid SaaS platforms.
      </p>
    </div>

    <!-- Table Container -->
    <div class="max-w-4xl mx-auto bg-white dark:bg-[#111111] rounded-2xl border border-[#ebebeb] dark:border-[#262626] overflow-hidden shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="bg-[#fafafa] dark:bg-[#181818] border-b border-[#ebebeb] dark:border-[#262626] text-xs font-mono text-[#525252] dark:text-[#a1a1a1] uppercase">
              <th class="py-4 px-6 font-semibold">Feature / Capability</th>
              <th class="py-4 px-6 font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50/50 dark:bg-emerald-950/40">Instant Shorts AI</th>
              <th class="py-4 px-6 font-semibold text-[#4d4d4d] dark:text-[#888888]">Traditional Viewmax / SaaS</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#ebebeb] dark:divide-[#262626] text-[#171717] dark:text-[#ededed]">
            <tr>
              <td class="py-4 px-6 font-medium">Paid LLM API Key Requirement</td>
              <td class="py-4 px-6 font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50/30 dark:bg-emerald-950/20 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span>Zero ($0 Required)</span>
              </td>
              <td class="py-4 px-6 text-[#4d4d4d] dark:text-[#a1a1a1]">Requires OpenAI / ElevenLabs API Key</td>
            </tr>

            <tr>
              <td class="py-4 px-6 font-medium">Voiceover Synthesizer Cost</td>
              <td class="py-4 px-6 font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50/30 dark:bg-emerald-950/20 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span>Unlimited (Web Speech + Free HF)</span>
              </td>
              <td class="py-4 px-6 text-[#4d4d4d] dark:text-[#a1a1a1]">$0.30+ per minute of generated audio</td>
            </tr>

            <tr>
              <td class="py-4 px-6 font-medium">Rendering Speed</td>
              <td class="py-4 px-6 font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50/30 dark:bg-emerald-950/20 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span>Instant In-Browser GPU</span>
              </td>
              <td class="py-4 px-6 text-[#4d4d4d] dark:text-[#a1a1a1]">Queue waits up to 5-10 mins</td>
            </tr>

            <tr>
              <td class="py-4 px-6 font-medium">Export Video Resolution</td>
              <td class="py-4 px-6 font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50/30 dark:bg-emerald-950/20 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span>1080x1920 60 FPS (No Watermark)</span>
              </td>
              <td class="py-4 px-6 text-[#4d4d4d] dark:text-[#a1a1a1]">720p or Watermarked on Free Tiers</td>
            </tr>

            <tr>
              <td class="py-4 px-6 font-medium">Batch Content Pipeline</td>
              <td class="py-4 px-6 font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50/30 dark:bg-emerald-950/20 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span>30 Shorts in 1-Click</span>
              </td>
              <td class="py-4 px-6 text-[#4d4d4d] dark:text-[#a1a1a1]">Single video generation limit</td>
            </tr>

            <tr>
              <td class="py-4 px-6 font-medium">Privacy & Data Control</td>
              <td class="py-4 px-6 font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50/30 dark:bg-emerald-950/20 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                <span>100% Local / Self-Contained</span>
              </td>
              <td class="py-4 px-6 text-[#4d4d4d] dark:text-[#a1a1a1]">Data stored on third-party servers</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>
