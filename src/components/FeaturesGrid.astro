---
---

<section id="features" class="py-16 md:py-24 border-b border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#080808] relative transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="font-mono text-xs font-semibold tracking-widest text-[#525252] dark:text-[#a1a1a1] uppercase">
        VIRAL AUTOMATION ENGINE • INSTANT SHORTS AI
      </div>
      <h2 class="text-3xl md:text-5xl font-semibold text-[#171717] dark:text-white tracking-tight">
        Everything You Need to Scale Faceless Channels
      </h2>
      <p class="text-[#4d4d4d] dark:text-[#a1a1a1] text-base sm:text-lg font-normal">
        From viral script hooks to automated 9:16 rendering and scheduling, Instant Shorts AI replaces a 5-person video editing team.
      </p>
    </div>

    <!-- 6-Grid Hairline Feature Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Feature 1 -->
      <div class="bg-[#fafafa] dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] space-y-4 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all group">
        <div class="w-10 h-10 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          Batch 30 Shorts in 3 Minutes
        </h3>
        <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Queue up an entire month's worth of viral YouTube Shorts or Instagram Reels in a single click. Generate, preview, and export in bulk.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-[#fafafa] dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] space-y-4 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all group">
        <div class="w-10 h-10 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center">
          <svg class="w-5 h-5 text-cyan-400 dark:text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
          Semantic B-Roll Visual Matcher
        </h3>
        <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          AI reads every sentence in your script and automatically places relevant 9:16 HD background footage or custom uploaded videos.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-[#fafafa] dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] space-y-4 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all group">
        <div class="w-10 h-10 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center">
          <svg class="w-5 h-5 text-yellow-400 dark:text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-yellow-600 dark:group-hover:text-yellow-400 transition-colors">
          Dynamic Subtitle Animations
        </h3>
        <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Captivate attention with word-by-word active word highlighting, emoji injection, and famous creator presets (MrBeast, Hormozi, Cyberpunk).
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="bg-[#fafafa] dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] space-y-4 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all group">
        <div class="w-10 h-10 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-400 dark:text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          100% Monetization Rights
        </h3>
        <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Keep 100% of your AdSense, YouTube Partner Program, and Instagram Creator Fund revenues. All footage and music are copyright cleared.
        </p>
      </div>

      <!-- Feature 5 -->
      <div class="bg-[#fafafa] dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] space-y-4 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all group">
        <div class="w-10 h-10 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center">
          <svg class="w-5 h-5 text-purple-400 dark:text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
          Multi-Channel Auto Poster
        </h3>
        <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Schedule posts directly to YouTube Shorts, Instagram Reels, and TikTok. Publish automatically at peak traffic hours.
        </p>
      </div>

      <!-- Feature 6 -->
      <div class="bg-[#fafafa] dark:bg-[#111111] p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] space-y-4 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all group">
        <div class="w-10 h-10 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center">
          <svg class="w-5 h-5 text-pink-400 dark:text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[#171717] dark:text-white tracking-tight group-hover:text-pink-600 dark:group-hover:text-pink-400 transition-colors">
          Viral Hook AI Optimizer
        </h3>
        <p class="text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Uses psychological hook formulas ("Did you know...", "3 Rules nobody tells you...", "Stop doing this...") to ensure max retention.
        </p>
      </div>

    </div>
  </div>
</section>
