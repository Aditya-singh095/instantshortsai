---
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28 border-b border-[#ebebeb] dark:border-[#262626] hero-mesh-gradient transition-colors">
  
  <!-- Decorative background elements -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      
      <!-- Monospace Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/80 dark:bg-black/60 border border-[#ebebeb] dark:border-[#333333] shadow-xs backdrop-blur-md">
        <span class="font-mono text-[11px] font-semibold tracking-wider text-[#171717] dark:text-[#ededed] uppercase flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
          INSTANT SHORTS AI • NO PAID API KEYS REQUIRED
        </span>
      </div>

      <!-- Headline in Geist tight tracking -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-semibold text-[#171717] dark:text-white tracking-[-0.05em] leading-[1.05] max-w-3xl mx-auto">
        Generate Viral Shorts & Reels in 1-Click.
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-neutral-900 via-violet-700 to-cyan-600 dark:from-white dark:via-violet-400 dark:to-cyan-400">
          100% Free LLM Engine.
        </span>
      </h1>

      <!-- Body Copy -->
      <p class="text-base sm:text-xl text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto font-normal leading-relaxed">
        The open-source Viewmax alternative for faceless YouTube Shorts, Instagram Reels, and TikToks. 
        Auto-generates scripts, AI voiceovers, dynamic animated captions, and 9:16 background footage—without OpenAI or ElevenLabs bills.
      </p>

      <!-- Quick Interactive Prompt Input Bar -->
      <div class="pt-4 max-w-2xl mx-auto">
        <div class="bg-white dark:bg-[#111111] p-2 sm:p-2.5 rounded-2xl border border-[#ebebeb] dark:border-[#333333] shadow-lg flex flex-col sm:flex-row items-stretch sm:items-center gap-2 transition-all focus-within:border-neutral-400 dark:focus-within:border-neutral-500 focus-within:ring-2 focus-within:ring-neutral-200 dark:focus-within:ring-neutral-800">
          <div class="flex-1 flex items-center px-3 gap-2">
            <svg class="w-5 h-5 text-[#8f8f8f] dark:text-[#a1a1a1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            <input 
              id="heroPromptInput" 
              type="text" 
              placeholder="e.g. 5 Stoic rules to master your emotions in 2026..." 
              class="w-full text-sm text-[#171717] dark:text-white placeholder-[#8f8f8f] dark:placeholder-[#666666] bg-transparent outline-none py-1.5"
              value="5 Mind-Blowing Stoic Quotes for Peak Focus"
            />
          </div>
          <a 
            href="#studio" 
            id="heroGenerateBtn"
            class="px-6 py-3 bg-[#171717] dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-200 text-white dark:text-black text-sm font-semibold rounded-xl transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-xl active:scale-[0.98]"
          >
            <span>Create Short</span>
            <svg class="w-4 h-4 text-cyan-400 dark:text-violet-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/>
            </svg>
          </a>
        </div>

        <!-- Niche Selector Pills -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
          <span class="text-xs font-mono text-[#8f8f8f] dark:text-[#a1a1a1] mr-1">Popular Topics:</span>
          <button class="hero-topic-tag px-3 py-1 bg-white dark:bg-[#111111] hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] text-xs font-medium rounded-full transition-all">
            🧠 Stoicism & Mindset
          </button>
          <button class="hero-topic-tag px-3 py-1 bg-white dark:bg-[#111111] hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] text-xs font-medium rounded-full transition-all">
            🌌 Dark Space Facts
          </button>
          <button class="hero-topic-tag px-3 py-1 bg-white dark:bg-[#111111] hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] text-xs font-medium rounded-full transition-all">
            💰 Wealth & Money Hacks
          </button>
          <button class="hero-topic-tag px-3 py-1 bg-white dark:bg-[#111111] hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] text-xs font-medium rounded-full transition-all">
            🔪 Unsolved Mysteries
          </button>
        </div>
      </div>

      <!-- Trust Metrics Strip -->
      <div class="pt-8 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto text-left">
        <div class="bg-white dark:bg-[#111111] p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-xs">
          <div class="text-2xl font-semibold text-[#171717] dark:text-white tracking-tight">100% Free</div>
          <div class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] font-normal mt-0.5">No Paid API Keys Needed</div>
        </div>
        <div class="bg-white dark:bg-[#111111] p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-xs">
          <div class="text-2xl font-semibold text-[#171717] dark:text-white tracking-tight">&lt; 30 Secs</div>
          <div class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] font-normal mt-0.5">Script-to-Video Speed</div>
        </div>
        <div class="bg-white dark:bg-[#111111] p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-xs">
          <div class="text-2xl font-semibold text-[#171717] dark:text-white tracking-tight">9:16 HD</div>
          <div class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] font-normal mt-0.5">YouTube, IG & TikTok</div>
        </div>
        <div class="bg-white dark:bg-[#111111] p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-xs">
          <div class="text-2xl font-semibold text-[#171717] dark:text-white tracking-tight">Web-LLM</div>
          <div class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] font-normal mt-0.5">Local In-Browser Engine</div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.hero-topic-tag').forEach(tag => {
    tag.addEventListener('click', (e) => {
      const text = (e.target as HTMLElement).innerText.replace(/^[^\w\s]+/, '').trim();
      const input = document.getElementById('heroPromptInput') as HTMLInputElement;
      if (input) {
        input.value = text;
        const studioInput = document.getElementById('studioTopicInput') as HTMLInputElement;
        if (studioInput) studioInput.value = text;
      }
      document.getElementById('studio')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  document.getElementById('heroGenerateBtn')?.addEventListener('click', () => {
    const heroVal = (document.getElementById('heroPromptInput') as HTMLInputElement)?.value;
    const studioInput = document.getElementById('studioTopicInput') as HTMLInputElement;
    if (studioInput && heroVal) {
      studioInput.value = heroVal;
    }
  });
</script>
