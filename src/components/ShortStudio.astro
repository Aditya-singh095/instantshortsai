---
---

<section id="studio" class="py-16 md:py-24 border-b border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#080808] relative transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <div class="font-mono text-xs font-semibold tracking-widest text-[#525252] dark:text-[#a1a1a1] uppercase mb-2">
          INTERACTIVE AI STUDIO • VIEWMAX ENGINE
        </div>
        <h2 class="text-3xl md:text-4xl font-semibold text-[#171717] dark:text-white tracking-tight">
          Instant Shorts Studio
        </h2>
        <p class="text-[#4d4d4d] dark:text-[#a1a1a1] text-sm md:text-base mt-1 max-w-xl">
          Customize scripts, add Instagram trending audio (Legacy slowed, Pixy), upload & trim custom music, arrange multiple images/videos with filter effects, and preview/export 9:16 HD vertical video.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <!-- WebGPU / Web-LLM Live Status Chip -->
        <div id="webGpuStatusChip" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-violet-50 dark:bg-violet-950/60 border border-violet-200 dark:border-violet-800 font-mono text-xs text-violet-900 dark:text-violet-300 transition-all">
          <span id="webGpuDot" class="w-2 h-2 rounded-full bg-violet-600"></span>
          <span id="webGpuStatusText">In-Browser Web-LLM Ready</span>
        </div>

        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 font-mono text-xs text-emerald-900 dark:text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Zero Paid API Tokens</span>
        </div>
      </div>
    </div>

    <!-- Studio Sandbox Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT: Control Panel (7 cols) -->
      <div class="lg:col-span-7 bg-[#fafafa] dark:bg-[#111111] rounded-2xl border border-[#ebebeb] dark:border-[#262626] p-5 md:p-6 space-y-6 shadow-sm transition-colors">
        
        <!-- Tab 1: Topic & Script -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <label for="studioTopicInput" class="text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] dark:text-[#ededed] flex items-center gap-1.5">
              <span class="w-5 h-5 rounded bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center text-[10px]">1</span>
              Video Topic & Web-LLM Script Generator
            </label>
            <div class="flex items-center gap-1.5">
              <button 
                id="btnOpenByokModal"
                type="button"
                class="text-xs font-mono text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white font-medium flex items-center gap-1 focus-visible:outline-2 focus-visible:outline-neutral-600 rounded px-2 py-0.5 bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all border border-neutral-200 dark:border-neutral-700"
                title="Configure optional BYOK API Key (Groq / OpenAI)"
              >
                <span>🔑</span> <span id="byokBtnLabel">BYOK API Key</span>
              </button>
              <button 
                id="btnAutoScript" 
                type="button"
                class="text-xs font-mono text-violet-700 dark:text-violet-400 hover:text-violet-900 dark:hover:text-violet-300 font-semibold flex items-center gap-1.5 focus-visible:outline-2 focus-visible:outline-violet-600 rounded px-1.5 py-0.5 bg-violet-50 dark:bg-violet-950/60 hover:bg-violet-100 dark:hover:bg-violet-900/60 transition-all border border-violet-200 dark:border-violet-800"
              >
                <svg id="llmSparkleIcon" class="w-3.5 h-3.5 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span id="btnAutoScriptText">Generate with Web-LLM</span>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label for="studioTopicInput" class="sr-only">Video Topic</label>
              <input 
                id="studioTopicInput" 
                type="text" 
                class="w-full text-xs md:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] rounded-lg px-3 py-2 text-[#171717] dark:text-[#ededed] outline-none focus-visible:border-neutral-900 focus-visible:ring-2 focus-visible:ring-neutral-200 dark:focus-visible:ring-neutral-700" 
                value="5 Mind-Blowing Stoic Quotes for Peak Focus"
                placeholder="Enter your topic..."
                aria-label="Video Topic"
              />
            </div>
            <div>
              <label for="nicheSelect" class="sr-only">Niche Category</label>
              <select 
                id="nicheSelect" 
                class="w-full text-xs md:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] rounded-lg px-3 py-2 text-[#171717] dark:text-[#ededed] outline-none focus-visible:border-neutral-900 focus-visible:ring-2 focus-visible:ring-neutral-200 dark:focus-visible:ring-neutral-700"
                aria-label="Niche Category Preset"
              >
                <option value="stoicism">🧠 Stoicism & Life Wisdom</option>
                <option value="space">🌌 Dark Space & Universe Secrets</option>
                <option value="money">💰 Money & Wealth Hacks</option>
                <option value="crime">🔪 Unsolved History Mysteries</option>
                <option value="quiz">❓ Interactive Trivia Quiz</option>
                <option value="tech">⚡ Tech & AI Futures</option>
              </select>
            </div>
          </div>

          <!-- Script Textarea -->
          <div class="relative">
            <label for="scriptTextarea" class="sr-only">Video Script Content</label>
            <textarea 
              id="scriptTextarea" 
              rows="3" 
              class="w-full text-xs md:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] rounded-lg p-3 text-[#171717] dark:text-[#ededed] outline-none font-mono leading-relaxed focus-visible:border-neutral-900 focus-visible:ring-2 focus-visible:ring-neutral-200 dark:focus-visible:ring-neutral-700 resize-none transition-all"
              placeholder="Script lines will appear here..."
              aria-label="Video Script Content"
            >Did you know Marcus Aurelius wrote: 'You have power over your mind - not outside events. Realize this, and you will find strength.' Here are 3 stoic rules to double your focus today. Rule number one: control what you can, ignore the rest.</textarea>
            
            <div class="absolute bottom-2 right-2 flex items-center gap-2">
              <span id="streamingTokenBadge" class="hidden text-[10px] font-mono bg-violet-100 dark:bg-violet-950 text-violet-900 dark:text-violet-200 px-2 py-0.5 rounded animate-pulse border border-violet-300 dark:border-violet-800">
                ⚡ Streaming Web-LLM...
              </span>
              <div class="text-[10px] font-mono text-[#525252] dark:text-[#a1a1a1] bg-white/95 dark:bg-black/90 backdrop-blur-xs px-2 py-0.5 rounded border border-[#ebebeb] dark:border-[#333333]">
                <span id="wordCountDisplay" class="font-bold text-[#171717] dark:text-white">39</span> words (~<span id="durationEst">22s</span>)
              </div>
            </div>
          </div>
        </div>

        <hr class="border-[#ebebeb] dark:border-[#262626]" />

        <!-- Tab 2: Trending Audio & Trimming Engine -->
        <div class="space-y-4">
          <label class="text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] dark:text-[#ededed] flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <span class="w-5 h-5 rounded bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center text-[10px]">2</span>
              Instagram Trending Audio & Music Trimmer
            </span>
            <span class="text-[10px] text-pink-600 dark:text-pink-400 font-bold flex items-center gap-1">
              🔥 Trending IG Sounds
            </span>
          </label>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="voiceSelect" class="text-[11px] font-mono text-[#333333] dark:text-[#a1a1a1] font-medium block mb-1">AI Voiceover Narrator</label>
              <select 
                id="voiceSelect" 
                class="w-full text-xs bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] rounded-lg p-2 text-[#171717] dark:text-[#ededed] outline-none focus-visible:ring-2 focus-visible:ring-neutral-200 dark:focus-visible:ring-neutral-700"
              >
                <option value="default">Standard AI Narrator (Default)</option>
              </select>
            </div>

            <div>
              <label for="musicSelect" class="text-[11px] font-mono text-[#333333] dark:text-[#a1a1a1] font-medium block mb-1">Background Audio Mode</label>
              <select 
                id="musicSelect" 
                class="w-full text-xs bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] rounded-lg p-2 text-[#171717] dark:text-[#ededed] outline-none focus-visible:ring-2 focus-visible:ring-neutral-200 dark:focus-visible:ring-neutral-700 font-semibold"
              >
                <option value="custom" selected>📁 Upload Custom Audio Track (.mp3, .wav, .m4a)</option>
                <option value="none">🔇 Voiceover Only (No Background Music)</option>
              </select>
              <div id="activeTrackUrlBadge" class="mt-1 text-[10px] font-mono text-cyan-600 dark:text-cyan-400 truncate bg-cyan-50 dark:bg-cyan-950/40 px-2 py-0.5 rounded border border-cyan-200 dark:border-cyan-800">
                🎵 Audio Status: Custom Upload Ready (Click Upload Audio File below)
              </div>
            </div>
          </div>

          <!-- Custom Audio Upload & Trimmer Control Panel -->
          <div id="audioTrimmerPanel" class="bg-white dark:bg-[#1a1a1a] p-3.5 rounded-xl border border-[#ebebeb] dark:border-[#333333] space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <input type="file" id="customAudioInput" accept="audio/*" class="hidden" />
                <button 
                  id="btnTriggerAudioUpload" 
                  type="button" 
                  class="px-3 py-1.5 bg-pink-50 dark:bg-pink-950/60 border border-pink-200 dark:border-pink-800 text-pink-700 dark:text-pink-300 font-semibold text-xs rounded-lg flex items-center gap-1.5 hover:bg-pink-100 transition-all"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                  </svg>
                  <span>Upload Audio File</span>
                </button>
                <span id="customAudioFileName" class="text-xs font-mono text-neutral-600 dark:text-neutral-400 truncate max-w-[180px]">No file chosen</span>
              </div>

              <button 
                id="btnPreviewAudioTrim" 
                type="button"
                class="px-2.5 py-1 text-xs font-mono bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 text-neutral-800 dark:text-neutral-200 rounded border border-neutral-200 dark:border-neutral-700 flex items-center gap-1"
              >
                <span id="trimAudioPlayIcon">▶</span>
                <span id="trimAudioBtnText">Test Trimmed Track</span>
              </button>
            </div>

            <!-- Audio Trimmer Sliders Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
              <div>
                <div class="flex justify-between text-[10px] font-mono text-[#525252] dark:text-[#a1a1a1] mb-1">
                  <label for="musicTrimStart">Trim Start</label>
                  <span id="musicTrimStartVal" class="font-bold text-[#171717] dark:text-white">0s</span>
                </div>
                <input 
                  id="musicTrimStart" 
                  type="range" 
                  min="0" 
                  max="120" 
                  step="1" 
                  value="0" 
                  class="w-full accent-pink-600 h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg cursor-pointer"
                />
              </div>

              <div>
                <div class="flex justify-between text-[10px] font-mono text-[#525252] dark:text-[#a1a1a1] mb-1">
                  <label for="musicTrimDuration">Clip Duration</label>
                  <span id="musicTrimDurationVal" class="font-bold text-[#171717] dark:text-white">22s</span>
                </div>
                <input 
                  id="musicTrimDuration" 
                  type="range" 
                  min="5" 
                  max="60" 
                  step="1" 
                  value="22" 
                  class="w-full accent-pink-600 h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg cursor-pointer"
                />
              </div>

              <div>
                <div class="flex justify-between text-[10px] font-mono text-[#525252] dark:text-[#a1a1a1] mb-1">
                  <label for="musicVolume">Music Volume</label>
                  <span id="musicVolumeVal" class="font-bold text-[#171717] dark:text-white">80%</span>
                </div>
                <input 
                  id="musicVolume" 
                  type="range" 
                  min="0" 
                  max="100" 
                  step="5" 
                  value="80" 
                  class="w-full accent-pink-600 h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg cursor-pointer"
                />
              </div>

              <div>
                <div class="flex justify-between text-[10px] font-mono text-[#525252] dark:text-[#a1a1a1] mb-1">
                  <label for="musicSpeedRate">Speed / Tone</label>
                  <span id="musicSpeedRateVal" class="font-bold text-[#171717] dark:text-white">1.0x</span>
                </div>
                <input 
                  id="musicSpeedRate" 
                  type="range" 
                  min="0.5" 
                  max="1.5" 
                  step="0.1" 
                  value="1.0" 
                  class="w-full accent-pink-600 h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg cursor-pointer"
                />
              </div>
            </div>

            <!-- Voiceover Pitch & Speed Row -->
            <div class="grid grid-cols-2 gap-3 pt-2 border-t border-neutral-100 dark:border-neutral-800">
              <div>
                <div class="flex justify-between text-[10px] font-mono text-[#525252] dark:text-[#a1a1a1] mb-1">
                  <label for="rateSlider">Speech Speed</label>
                  <span id="rateVal" class="font-bold text-[#171717] dark:text-white">1.1x</span>
                </div>
                <input 
                  id="rateSlider" 
                  type="range" 
                  min="0.8" 
                  max="1.5" 
                  step="0.1" 
                  value="1.1" 
                  class="w-full accent-neutral-900 dark:accent-white h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg cursor-pointer"
                />
              </div>
              <div>
                <div class="flex justify-between text-[10px] font-mono text-[#525252] dark:text-[#a1a1a1] mb-1">
                  <label for="pitchSlider">Speech Pitch</label>
                  <span id="pitchVal" class="font-bold text-[#171717] dark:text-white">1.0</span>
                </div>
                <input 
                  id="pitchSlider" 
                  type="range" 
                  min="0.7" 
                  max="1.3" 
                  step="0.1" 
                  value="1.0" 
                  class="w-full accent-neutral-900 dark:accent-white h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg cursor-pointer"
                />
              </div>
            </div>
          </div>
        </div>

        <hr class="border-[#ebebeb] dark:border-[#262626]" />

        <!-- Tab 3: Multiple Media Assets & Timeline Editor -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <label class="text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] dark:text-[#ededed] flex items-center gap-1.5">
              <span class="w-5 h-5 rounded bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center text-[10px]">3</span>
              Multiple Images & Videos Timeline Editor
            </label>
            
            <div class="flex items-center gap-2">
              <input type="file" id="multiMediaInput" accept="image/*,video/*" multiple class="hidden" />
              <button 
                id="btnTriggerMultiUpload" 
                type="button" 
                class="px-2.5 py-1 bg-violet-600 hover:bg-violet-700 text-white font-semibold text-xs rounded-lg transition-all flex items-center gap-1 shadow-xs"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>+ Upload Multiple Clips</span>
              </button>
            </div>
          </div>

          <!-- Subtitle Style Radio Buttons -->
          <div>
            <label class="text-[11px] font-mono text-[#333333] dark:text-[#a1a1a1] font-medium block mb-1">Viral Subtitle Preset</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" role="radiogroup" aria-label="Subtitle Style Presets">
              <button 
                type="button"
                data-caption-style="mrbeast" 
                class="caption-style-btn p-2 rounded-lg border border-yellow-400 bg-yellow-50 dark:bg-yellow-950/40 text-center text-xs font-black uppercase tracking-tight text-neutral-900 dark:text-yellow-300 transition-all ring-2 ring-yellow-400"
                aria-checked="true"
              >
                ⚡ MrBeast Yellow
              </button>
              <button 
                type="button"
                data-caption-style="hormozi" 
                class="caption-style-btn p-2 rounded-lg border border-[#ebebeb] dark:border-[#333333] bg-neutral-900 text-center text-xs font-black uppercase tracking-tight text-cyan-400 transition-all"
                aria-checked="false"
              >
                🔥 Hormozi Glow
              </button>
              <button 
                type="button"
                data-caption-style="cyberpunk" 
                class="caption-style-btn p-2 rounded-lg border border-[#ebebeb] dark:border-[#333333] bg-purple-950 text-center text-xs font-black uppercase tracking-tight text-pink-400 transition-all"
                aria-checked="false"
              >
                🌆 Neon Cyber
              </button>
              <button 
                type="button"
                data-caption-style="geist" 
                class="caption-style-btn p-2 rounded-lg border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#1a1a1a] text-center text-xs font-mono uppercase tracking-tight text-[#171717] dark:text-[#ededed] transition-all"
                aria-checked="false"
              >
                🔳 Geist Minimal
              </button>
            </div>
          </div>

          <!-- Preset Footage Loops -->
          <div>
            <label class="text-[11px] font-mono text-[#333333] dark:text-[#a1a1a1] font-medium block mb-1">Preset Footage Packs</label>
            <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
              <button type="button" data-preset-pack="minecraft" class="preset-pack-btn border-2 border-neutral-900 dark:border-white rounded-lg p-1.5 text-center text-[11px] font-mono bg-emerald-100 dark:bg-emerald-950 text-emerald-950 dark:text-emerald-200 font-bold truncate">🎮 Minecraft</button>
              <button type="button" data-preset-pack="asmr" class="preset-pack-btn border border-[#ebebeb] dark:border-[#333333] rounded-lg p-1.5 text-center text-[11px] font-mono bg-pink-50 dark:bg-pink-950/40 text-pink-950 dark:text-pink-200 font-medium truncate">🧼 ASMR</button>
              <button type="button" data-preset-pack="gta" class="preset-pack-btn border border-[#ebebeb] dark:border-[#333333] rounded-lg p-1.5 text-center text-[11px] font-mono bg-amber-50 dark:bg-amber-950/40 text-amber-950 dark:text-amber-200 font-medium truncate">🚗 GTA Ramp</button>
              <button type="button" data-preset-pack="space" class="preset-pack-btn border border-[#ebebeb] dark:border-[#333333] rounded-lg p-1.5 text-center text-[11px] font-mono bg-indigo-50 dark:bg-indigo-950/40 text-indigo-950 dark:text-indigo-200 font-medium truncate">🌌 Space</button>
              <button type="button" data-preset-pack="cyberpunk" class="preset-pack-btn border border-[#ebebeb] dark:border-[#333333] rounded-lg p-1.5 text-center text-[11px] font-mono bg-cyan-50 dark:bg-cyan-950/40 text-cyan-950 dark:text-cyan-200 font-medium truncate">🏙️ Cyber</button>
              <button type="button" data-preset-pack="luxury" class="preset-pack-btn border border-[#ebebeb] dark:border-[#333333] rounded-lg p-1.5 text-center text-[11px] font-mono bg-neutral-100 dark:bg-neutral-900 text-neutral-950 dark:text-neutral-200 font-medium truncate">🏎️ Luxury</button>
            </div>
          </div>

          <!-- Dynamic Multi-Media Sequence Timeline Container -->
          <div class="bg-white dark:bg-[#1a1a1a] p-3 rounded-xl border border-[#ebebeb] dark:border-[#333333] space-y-2">
            <div class="flex items-center justify-between text-xs font-mono font-semibold text-[#171717] dark:text-white">
              <span>Active Sequence Playlist (<span id="timelineCountDisplay">1</span> clips)</span>
              <button id="btnClearTimeline" type="button" class="text-[10px] text-red-500 hover:underline">Clear All Clips</button>
            </div>

            <div id="timelineItemsContainer" class="space-y-2 max-h-[260px] overflow-y-auto pr-1">
              <!-- Timeline cards injected dynamically via JS -->
            </div>
          </div>
        </div>

        <!-- Render & Test Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <button 
            id="btnRenderShort" 
            type="button"
            class="flex-1 py-3.5 px-5 bg-[#171717] dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-200 text-white dark:text-black font-semibold text-sm rounded-xl transition-all flex items-center justify-center gap-2 shadow-md active:scale-[0.99]"
          >
            <svg id="renderBtnIcon" class="w-4 h-4 text-cyan-400 dark:text-violet-600 fill-current" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <span id="renderBtnText">Play Preview with Voiceover & Music</span>
          </button>
          
          <button 
            id="btnOpenExportModal" 
            type="button"
            class="py-3.5 px-5 bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] hover:bg-neutral-50 dark:hover:bg-neutral-800 text-[#171717] dark:text-[#ededed] font-semibold text-sm rounded-xl transition-all flex items-center justify-center gap-2 shadow-xs"
          >
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Export 1080p Video (.webm)</span>
          </button>
        </div>

      </div>

      <!-- RIGHT: Interactive 9:16 Vertical Video Studio Player (5 cols) -->
      <div class="lg:col-span-5 flex flex-col items-center">
        
        <!-- Smartphone Container -->
        <div class="relative w-full max-w-[320px] aspect-[9/16] bg-neutral-950 rounded-[36px] p-3 shadow-2xl border-4 border-neutral-800 overflow-hidden group">
          
          <!-- Phone Speaker Notch -->
          <div class="absolute top-4 left-1/2 -translate-x-1/2 w-24 h-4 bg-neutral-900 rounded-full z-30 flex items-center justify-center pointer-events-none">
