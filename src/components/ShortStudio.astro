<script>
  import { generateViralScriptWithWebLLM, isWebGPUSupported } from '../lib/webLlmService';
  import { renderAndExportShortVideo, type MediaClip, type AudioTrackOptions } from '../lib/videoExporter';

  const NICHE_LABELS: Record<string, string> = {
    stoicism: "Stoic Mindset #Shorts",
    space: "Dark Space Mysteries #Shorts",
    money: "Wealth Secrets #Shorts",
    crime: "Unsolved History #Shorts",
    quiz: "Daily Trivia Quiz #Shorts",
    tech: "Future of AI #Shorts"
  };

  const PRESET_PACKS: Record<string, MediaClip[]> = {
    minecraft: [
      { id: 'mc_1', url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🎮 Minecraft Parkour 1', durationSec: 7, filterEffect: 'kenburns' },
      { id: 'mc_2', url: 'https://images.unsplash.com/photo-1579546929518-9e396f3cc809?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🎮 Neon Block 2', durationSec: 8, filterEffect: 'vibrant' },
      { id: 'mc_3', url: 'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🎮 Cyber World 3', durationSec: 7, filterEffect: 'kenburns' }
    ],
    asmr: [
      { id: 'asmr_1', url: 'https://images.unsplash.com/photo-1579546929518-9e396f3cc809?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🧼 Soap Slice 1', durationSec: 10, filterEffect: 'vintage' },
      { id: 'asmr_2', url: 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🧼 Kinetic Sand 2', durationSec: 12, filterEffect: 'noir' }
    ],
    gta: [
      { id: 'gta_1', url: 'https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🚗 GTA Ramp Jump', durationSec: 11, filterEffect: 'vibrant' },
      { id: 'gta_2', url: 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🏎️ Supercar Drift', durationSec: 11, filterEffect: 'kenburns' }
    ],
    space: [
      { id: 'sp_1', url: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🌌 Galaxy Nebula', durationSec: 11, filterEffect: 'kenburns' },
      { id: 'sp_2', url: 'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🌌 Deep Cosmos', durationSec: 11, filterEffect: 'noir' }
    ],
    cyberpunk: [
      { id: 'cy_1', url: 'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🏙️ Cyber City Lights', durationSec: 11, filterEffect: 'vibrant' },
      { id: 'cy_2', url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🌆 Neon Grid', durationSec: 11, filterEffect: 'kenburns' }
    ],
    luxury: [
      { id: 'lux_1', url: 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80', type: 'image', name: '🏎️ Luxury Hypercar', durationSec: 11, filterEffect: 'vintage' },
      { id: 'lux_2', url: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80', type: 'image', name: '💎 Diamond Mansion', durationSec: 11, filterEffect: 'kenburns' }
    ]
  };

  // State
  let currentCaptionStyle = 'mrbeast';
  let activeMediaClips: MediaClip[] = [...PRESET_PACKS.minecraft];
  let customAudioObjectUrl: string | null = null;
  let customAudioFileNameText = 'No file chosen';

  // Elements
  const visualBgElement = document.getElementById('visualBgElement');
  const liveUploadedVideo = document.getElementById('liveUploadedVideo') as HTMLVideoElement;
  const captionText = document.getElementById('captionText');
  const subcaptionText = document.getElementById('subcaptionText');

  // Custom Audio Controls & Elements
  const musicSelect = document.getElementById('musicSelect') as HTMLSelectElement;
  const customAudioInput = document.getElementById('customAudioInput') as HTMLInputElement;
  const btnTriggerAudioUpload = document.getElementById('btnTriggerAudioUpload');
  const customAudioFileName = document.getElementById('customAudioFileName');
  const musicTrimStart = document.getElementById('musicTrimStart') as HTMLInputElement;
  const musicTrimStartVal = document.getElementById('musicTrimStartVal');
  const musicTrimDuration = document.getElementById('musicTrimDuration') as HTMLInputElement;
  const musicTrimDurationVal = document.getElementById('musicTrimDurationVal');
  const musicVolume = document.getElementById('musicVolume') as HTMLInputElement;
  const musicVolumeVal = document.getElementById('musicVolumeVal');
  const musicSpeedRate = document.getElementById('musicSpeedRate') as HTMLInputElement;
  const musicSpeedRateVal = document.getElementById('musicSpeedRateVal');
  const btnPreviewAudioTrim = document.getElementById('btnPreviewAudioTrim');
  const trimAudioBtnText = document.getElementById('trimAudioBtnText');
  const trimAudioPlayIcon = document.getElementById('trimAudioPlayIcon');

  let previewAudioEl: HTMLAudioElement | null = null;
  let isPreviewingAudio = false;

  // Custom Audio Upload
  btnTriggerAudioUpload?.addEventListener('click', () => {
    customAudioInput?.click();
  });

  customAudioInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    if (customAudioObjectUrl) URL.revokeObjectURL(customAudioObjectUrl);

    customAudioObjectUrl = URL.createObjectURL(file);
    customAudioFileNameText = file.name;
    if (customAudioFileName) customAudioFileName.textContent = file.name;
    if (musicSelect) musicSelect.value = 'custom';
  });

  // Music Slider Value Handlers
  musicTrimStart?.addEventListener('input', () => {
    if (musicTrimStartVal) musicTrimStartVal.textContent = `${musicTrimStart.value}s`;
  });
  musicTrimDuration?.addEventListener('input', () => {
    if (musicTrimDurationVal) musicTrimDurationVal.textContent = `${musicTrimDuration.value}s`;
  });
  musicVolume?.addEventListener('input', () => {
    if (musicVolumeVal) musicVolumeVal.textContent = `${musicVolume.value}%`;
  });
  musicSpeedRate?.addEventListener('input', () => {
    if (musicSpeedRateVal) musicSpeedRateVal.textContent = `${musicSpeedRate.value}x`;
  });

  // Audio Trimmer Solo Preview
  function stopSoloAudioPreview() {
    if (previewAudioEl) {
      previewAudioEl.pause();
      previewAudioEl = null;
    }
    isPreviewingAudio = false;
    if (trimAudioBtnText) trimAudioBtnText.textContent = 'Test Trimmed Track';
    if (trimAudioPlayIcon) trimAudioPlayIcon.textContent = '▶';
  }

  btnPreviewAudioTrim?.addEventListener('click', () => {
    if (isPreviewingAudio) {
      stopSoloAudioPreview();
      return;
    }

    const trackId = musicSelect?.value || 'legacy_slowed';
    const trimStart = parseFloat(musicTrimStart?.value || '0');
    const trimDur = parseFloat(musicTrimDuration?.value || '22');
    const vol = parseFloat(musicVolume?.value || '80') / 100;
    const speed = parseFloat(musicSpeedRate?.value || '1.0');

    if (trackId === 'custom' && customAudioObjectUrl) {
      previewAudioEl = new Audio(customAudioObjectUrl);
      previewAudioEl.currentTime = trimStart;
      previewAudioEl.volume = vol;
      previewAudioEl.playbackRate = speed;
      previewAudioEl.play().catch(() => {});

      isPreviewingAudio = true;
      if (trimAudioBtnText) trimAudioBtnText.textContent = 'Stop Audio Preview';
      if (trimAudioPlayIcon) trimAudioPlayIcon.textContent = '⏹';

      setTimeout(() => {
        if (isPreviewingAudio) stopSoloAudioPreview();
      }, trimDur * 1000);
    } else {
      startBgMusic();
      isPreviewingAudio = true;
      if (trimAudioBtnText) trimAudioBtnText.textContent = 'Playing IG Sound...';
      if (trimAudioPlayIcon) trimAudioPlayIcon.textContent = '⏹';
      setTimeout(() => {
        if (isPreviewingAudio) {
          stopBgMusic();
          stopSoloAudioPreview();
        }
      }, trimDur * 1000);
    }
  });

  // Multiple Media Assets Upload & Timeline Management
  const multiMediaInput = document.getElementById('multiMediaInput') as HTMLInputElement;
  const btnTriggerMultiUpload = document.getElementById('btnTriggerMultiUpload');
  const timelineItemsContainer = document.getElementById('timelineItemsContainer');
  const timelineCountDisplay = document.getElementById('timelineCountDisplay');
  const btnClearTimeline = document.getElementById('btnClearTimeline');

  btnTriggerMultiUpload?.addEventListener('click', () => {
    multiMediaInput?.click();
  });

  multiMediaInput?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (!files || files.length === 0) return;

    Array.from(files).forEach((file, index) => {
      const url = URL.createObjectURL(file);
      const isVid = file.type.startsWith('video/');
      const newClip: MediaClip = {
        id: `custom_media_${Date.now()}_${index}`,
        url,
        type: isVid ? 'video' : 'image',
        name: file.name,
        durationSec: 5,
        filterEffect: 'kenburns',
        trimStartSec: 0
      };
      activeMediaClips.push(newClip);
    });

    renderTimelineUI();
    updateLivePreviewBackground(0);
  });

  btnClearTimeline?.addEventListener('click', () => {
    activeMediaClips = [];
    renderTimelineUI();
  });

  function renderTimelineUI() {
    if (!timelineItemsContainer) return;
    if (timelineCountDisplay) timelineCountDisplay.textContent = activeMediaClips.length.toString();

    if (activeMediaClips.length === 0) {
      timelineItemsContainer.innerHTML = `
        <div class="text-center py-4 font-mono text-xs text-neutral-400">
          No media clips in playlist. Click <strong>+ Upload Multiple Clips</strong> or select a Preset Pack above.
        </div>
      `;
      return;
    }

    timelineItemsContainer.innerHTML = activeMediaClips
      .map(
        (clip, idx) => `
      <div class="flex items-center justify-between gap-2 p-2 rounded-lg bg-neutral-50 dark:bg-[#111111] border border-neutral-200 dark:border-neutral-800 text-xs font-mono">
        <div class="flex items-center gap-2 shrink-0">
          <span class="w-4 h-4 rounded bg-neutral-900 dark:bg-white text-white dark:text-black flex items-center justify-center text-[10px] font-bold">${idx + 1}</span>
          <span class="px-1.5 py-0.5 rounded text-[9px] uppercase font-bold ${clip.type === 'video' ? 'bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300' : 'bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300'}">
            ${clip.type}
          </span>
        </div>

        <div class="flex-1 truncate max-w-[120px] font-semibold text-neutral-800 dark:text-neutral-200" title="${clip.name}">
          ${clip.name}
        </div>

        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1">
            <label class="text-[9px] text-neutral-400">Dur:</label>
            <input 
              type="number" 
              min="1" 
              max="60" 
              value="${clip.durationSec}" 
              data-clip-action="duration" 
              data-clip-index="${idx}" 
              class="w-10 bg-white dark:bg-[#1a1a1a] border border-neutral-300 dark:border-neutral-700 rounded px-1 text-center text-xs text-neutral-900 dark:text-white" 
            />
            <span class="text-[9px] text-neutral-400">s</span>
          </div>

          <select 
            data-clip-action="filter" 
            data-clip-index="${idx}" 
            class="text-[10px] bg-white dark:bg-[#1a1a1a] border border-neutral-300 dark:border-neutral-700 rounded px-1 py-0.5 text-neutral-800 dark:text-neutral-200"
          >
            <option value="kenburns" ${clip.filterEffect === 'kenburns' ? 'selected' : ''}>Ken Burns Zoom</option>
            <option value="noir" ${clip.filterEffect === 'noir' ? 'selected' : ''}>Noir Grayscale</option>
            <option value="vintage" ${clip.filterEffect === 'vintage' ? 'selected' : ''}>Vintage Warmth</option>
            <option value="vibrant" ${clip.filterEffect === 'vibrant' ? 'selected' : ''}>Vibrant Neon</option>
            <option value="blur" ${clip.filterEffect === 'blur' ? 'selected' : ''}>Soft Blur</option>
          </select>

          <div class="flex items-center gap-1">
            <button type="button" data-clip-action="up" data-clip-index="${idx}" class="p-1 hover:bg-neutral-200 dark:hover:bg-neutral-700 rounded text-neutral-600 dark:text-neutral-300" title="Move Up">▲</button>
            <button type="button" data-clip-action="down" data-clip-index="${idx}" class="p-1 hover:bg-neutral-200 dark:hover:bg-neutral-700 rounded text-neutral-600 dark:text-neutral-300" title="Move Down">▼</button>
            <button type="button" data-clip-action="delete" data-clip-index="${idx}" class="p-1 hover:bg-red-100 dark:hover:bg-red-950 rounded text-red-600 dark:text-red-400" title="Delete Clip">🗑️</button>
          </div>
        </div>
      </div>
    `
      )
      .join('');

    // Attach event handlers for clip options
    timelineItemsContainer.querySelectorAll('[data-clip-action]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-clip-index') || '0');
        const action = (e.target as HTMLElement).getAttribute('data-clip-action');
        if (action === 'duration') {
          activeMediaClips[index].durationSec = Math.max(1, parseInt((e.target as HTMLInputElement).value || '5'));
          updateScriptStats();
        } else if (action === 'filter') {
          activeMediaClips[index].filterEffect = (e.target as HTMLSelectElement).value as any;
          updateLivePreviewBackground(0);
        }
      });

      el.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-clip-action]');
        if (!btn) return;
        const index = parseInt(btn.getAttribute('data-clip-index') || '0');
        const action = btn.getAttribute('data-clip-action');

        if (action === 'up' && index > 0) {
          const temp = activeMediaClips[index];
          activeMediaClips[index] = activeMediaClips[index - 1];
          activeMediaClips[index - 1] = temp;
          renderTimelineUI();
          updateLivePreviewBackground(0);
        } else if (action === 'down' && index < activeMediaClips.length - 1) {
          const temp = activeMediaClips[index];
          activeMediaClips[index] = activeMediaClips[index + 1];
          activeMediaClips[index + 1] = temp;
          renderTimelineUI();
          updateLivePreviewBackground(0);
        } else if (action === 'delete') {
          activeMediaClips.splice(index, 1);
          renderTimelineUI();
          updateLivePreviewBackground(0);
        }
      });
    });
  }

  // Preset Pack Buttons
  document.querySelectorAll('.preset-pack-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-pack-btn').forEach((b) => {
        b.classList.remove('border-2', 'border-neutral-900', 'dark:border-white');
        b.classList.add('border-[#ebebeb]', 'dark:border-[#333333]');
      });
      btn.classList.add('border-2', 'border-neutral-900', 'dark:border-white');

      const packKey = btn.getAttribute('data-preset-pack') || 'minecraft';
      if (PRESET_PACKS[packKey]) {
        activeMediaClips = [...PRESET_PACKS[packKey]];
        renderTimelineUI();
        updateLivePreviewBackground(0);
      }
    });
  });

  renderTimelineUI();

  // Update Live Preview Media Background
  function updateLivePreviewBackground(elapsedSec: number) {
    if (!activeMediaClips || activeMediaClips.length === 0) return;

    let accumulated = 0;
    let currentClip = activeMediaClips[0];
    for (let i = 0; i < activeMediaClips.length; i++) {
      const dur = activeMediaClips[i].durationSec || 5;
      if (elapsedSec >= accumulated && elapsedSec < accumulated + dur) {
        currentClip = activeMediaClips[i];
        break;
      }
      accumulated += dur;
    }

    if (!currentClip) currentClip = activeMediaClips[0];

    // Apply Filter Effect to Preview Element
    const filter = currentClip.filterEffect || 'kenburns';
    let filterStyle = '';
    if (filter === 'noir') filterStyle = 'grayscale(100%) contrast(130%)';
    else if (filter === 'vintage') filterStyle = 'sepia(70%) saturate(140%)';
    else if (filter === 'vibrant') filterStyle = 'saturate(200%) contrast(115%)';
    else if (filter === 'blur') filterStyle = 'blur(6px)';

    if (currentClip.type === 'video') {
      if (visualBgElement && liveUploadedVideo) {
        visualBgElement.classList.add('hidden');
        liveUploadedVideo.classList.remove('hidden');
        liveUploadedVideo.style.filter = filterStyle;

        if (liveUploadedVideo.src !== currentClip.url) {
          liveUploadedVideo.src = currentClip.url;
          liveUploadedVideo.play().catch(() => {});
        }
      }
    } else {
      if (visualBgElement && liveUploadedVideo) {
        liveUploadedVideo.classList.add('hidden');
        liveUploadedVideo.pause();
        visualBgElement.classList.remove('hidden');
        visualBgElement.style.filter = filterStyle;
        visualBgElement.style.backgroundImage = `linear-gradient(to bottom, rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.8)), url('${currentClip.url}')`;
      }
    }
  }

  // Check WebGPU availability
  async function initWebGpuIndicator() {
    const hasGPU = await isWebGPUSupported();
    const statusText = document.getElementById('webGpuStatusText');
    const statusDot = document.getElementById('webGpuDot');
    if (hasGPU) {
      if (statusText) statusText.textContent = "WebGPU Accelerated Engine";
      if (statusDot) statusDot.className = "w-2 h-2 rounded-full bg-emerald-500 animate-pulse";
    } else {
      if (statusText) statusText.textContent = "Local In-Browser LLM Ready";
    }
  }
  initWebGpuIndicator();

  // Audio Context & Background Audio Engine
  let audioCtx: AudioContext | null = null;
  let bgMusicOscillators: any[] = [];
  let activeBgAudioEl: HTMLAudioElement | null = null;
  const activeTrackUrlBadge = document.getElementById('activeTrackUrlBadge');

  function initAudioCtx() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
  }

  function stopBgMusic() {
    bgMusicOscillators.forEach((osc) => {
      try { osc.stop(); } catch (_) {}
    });
    bgMusicOscillators = [];

    if (activeBgAudioEl) {
      try {
        activeBgAudioEl.pause();
        activeBgAudioEl.currentTime = 0;
      } catch (_) {}
      activeBgAudioEl = null;
    }
  }

  function startBgMusic() {
    stopBgMusic();
    const trackId = musicSelect?.value || 'custom';
    if (trackId === 'none' || !customAudioObjectUrl) {
      if (activeTrackUrlBadge) {
        activeTrackUrlBadge.textContent = !customAudioObjectUrl 
          ? '🎵 Audio Status: Please select an audio file using Upload Audio File' 
          : '🎵 Audio Mode: Voiceover Only (Silence)';
      }
      return;
    }

    if (activeTrackUrlBadge) {
      activeTrackUrlBadge.textContent = `🎵 Active Upload: ${customAudioFileName?.textContent || 'Custom Audio'}`;
    }

    try {
      activeBgAudioEl = new Audio(customAudioObjectUrl);
      activeBgAudioEl.loop = true;
      activeBgAudioEl.volume = (parseFloat(musicVolume?.value || '80') / 100);
      activeBgAudioEl.playbackRate = parseFloat(musicSpeedRate?.value || '1.0');
      activeBgAudioEl.currentTime = parseFloat(musicTrimStart?.value || '0');

      activeBgAudioEl.play().catch(e => {
        console.warn("Custom MP3 audio play note:", e);
      });
    } catch (e) {
      console.warn("Audio element error:", e);
    }
  }

  musicSelect?.addEventListener('change', () => {
    const trackId = musicSelect.value;
    if (trackId === 'custom' && !customAudioObjectUrl) {
      customAudioInput?.click();
    }
    if (isPlaying) startBgMusic();
    else stopBgMusic();
  });

  // Populate Web Speech API voices
  let synthVoices: SpeechSynthesisVoice[] = [];
  function loadVoices() {
    if ('speechSynthesis' in window) {
      synthVoices = window.speechSynthesis.getVoices();
      const voiceSelect = document.getElementById('voiceSelect') as HTMLSelectElement;
      if (voiceSelect && synthVoices.length > 0) {
        voiceSelect.innerHTML = '';
        synthVoices.forEach((voice, index) => {
          if (voice.lang.includes('en')) {
            const opt = document.createElement('option');
            opt.value = index.toString();
            opt.textContent = `${voice.name} (${voice.lang})`;
            voiceSelect.appendChild(opt);
          }
        });
      }
    }
  }

  if ('speechSynthesis' in window) {
    loadVoices();
    window.speechSynthesis.onvoiceschanged = loadVoices;
  }

  // Word Count & Script Stats
  const scriptTextarea = document.getElementById('scriptTextarea') as HTMLTextAreaElement;
  const wordCountDisplay = document.getElementById('wordCountDisplay');
  const durationEst = document.getElementById('durationEst');

  function updateScriptStats() {
    if (scriptTextarea && wordCountDisplay) {
      const words = scriptTextarea.value.trim().split(/\s+/).filter(Boolean).length;
      const rate = parseFloat((document.getElementById('rateSlider') as HTMLInputElement)?.value || '1.1');
      const sequenceDuration = activeMediaClips.reduce((sum, c) => sum + (c.durationSec || 5), 0);
      const speechDuration = Math.max(5, Math.round(words / (2.5 * rate)));
      const seconds = Math.max(speechDuration, sequenceDuration);

      wordCountDisplay.textContent = words.toString();
      if (durationEst) durationEst.textContent = `${seconds}s`;
    }
  }
  scriptTextarea?.addEventListener('input', updateScriptStats);

  // Niche Select
  const nicheSelect = document.getElementById('nicheSelect') as HTMLSelectElement;
  nicheSelect?.addEventListener('change', () => {
    updateScriptStats();
  });

  // Web-LLM Script Generation
  const btnAutoScript = document.getElementById('btnAutoScript');
  const btnAutoScriptText = document.getElementById('btnAutoScriptText');
  const streamingTokenBadge = document.getElementById('streamingTokenBadge');
  let isGeneratingScript = false;

  btnAutoScript?.addEventListener('click', async () => {
    if (isGeneratingScript) return;
    isGeneratingScript = true;
    if (btnAutoScriptText) btnAutoScriptText.textContent = "Generating Script...";
    if (streamingTokenBadge) streamingTokenBadge.classList.remove('hidden');

    const topic = (document.getElementById('studioTopicInput') as HTMLInputElement)?.value || 'Peak Focus';
    const niche = nicheSelect?.value || 'stoicism';

    scriptTextarea.value = "";
    try {
      await generateViralScriptWithWebLLM(
        topic,
        niche,
        (_chunk, fullText) => {
          scriptTextarea.value = fullText;
          updateScriptStats();
        },
        (report) => {
          if (btnAutoScriptText) {
            btnAutoScriptText.textContent = `${report.text.slice(0, 20)}...`;
          }
        }
      );
    } catch (e) {
      console.warn("Script generation note:", e);
    } finally {
      isGeneratingScript = false;
      if (btnAutoScriptText) btnAutoScriptText.textContent = "Generate with Web-LLM";
      if (streamingTokenBadge) streamingTokenBadge.classList.add('hidden');
      updateScriptStats();
    }
  });

  // Subtitle Style Toggle
  const captionBtns = document.querySelectorAll('.caption-style-btn');
  captionBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      captionBtns.forEach((b) => {
        b.classList.remove('ring-2', 'ring-yellow-400', 'border-yellow-400');
        b.classList.add('border-[#ebebeb]', 'dark:border-[#333333]');
        b.setAttribute('aria-checked', 'false');
      });
      btn.classList.add('ring-2', 'ring-yellow-400', 'border-yellow-400');
      btn.setAttribute('aria-checked', 'true');
      currentCaptionStyle = btn.getAttribute('data-caption-style') || 'mrbeast';

      if (captionText) {
        if (currentCaptionStyle === 'mrbeast') {
          captionText.className = 'text-2xl font-black uppercase text-yellow-300 drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] tracking-tight block animate-caption-pop break-words';
        } else if (currentCaptionStyle === 'hormozi') {
          captionText.className = 'text-2xl font-black uppercase text-cyan-400 drop-shadow-[0_0_12px_rgba(34,211,238,0.8)] tracking-wide block animate-caption-pop break-words';
        } else if (currentCaptionStyle === 'cyberpunk') {
          captionText.className = 'text-2xl font-black uppercase text-pink-500 drop-shadow-[0_0_10px_rgba(236,72,153,0.9)] tracking-widest block animate-caption-pop break-words';
        } else {
          captionText.className = 'text-xl font-mono uppercase text-white bg-black/90 px-3 py-1 rounded border border-white/20 tracking-normal block animate-caption-pop break-words';
        }
      }
    });
  });

  // Playback Synthesis & Interactive Preview Player (UNBREAKABLE ENGINE)
  let isPlaying = false;
  const btnPlayerToggle = document.getElementById('btnPlayerToggle');
  const playIcon = document.getElementById('playIcon');
  const pauseIcon = document.getElementById('pauseIcon');
  const renderBtnText = document.getElementById('renderBtnText');
  const waveBars = document.querySelectorAll('.wave-bar');
  let wordTimer: any = null;
  let playbackElapsed = 0;
  let playbackInterval: any = null;
  let speechSafetyTimeout: any = null;

  function setWaveformActive(active: boolean) {
    waveBars.forEach((bar, idx) => {
      if (active) {
        bar.classList.add('animate-pulse');
        (bar as HTMLElement).style.animationDelay = `${(idx * 0.1).toFixed(1)}s`;
        (bar as HTMLElement).style.height = `${[10, 18, 20, 14, 18, 12, 20, 14][idx % 8]}px`;
      } else {
        bar.classList.remove('animate-pulse');
        (bar as HTMLElement).style.height = `${[8, 12, 14, 10, 12, 8, 14, 8][idx % 8]}px`;
      }
    });
  }

  function stopSpeech() {
    try {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
    } catch (_) {}
    stopBgMusic();
    stopSoloAudioPreview();

    isPlaying = false;
    if (playIcon) playIcon.classList.remove('hidden');
    if (pauseIcon) pauseIcon.classList.add('hidden');
    if (renderBtnText) renderBtnText.textContent = 'Play Preview with Voiceover & Music';
    if (wordTimer) { clearInterval(wordTimer); wordTimer = null; }
    if (playbackInterval) { clearInterval(playbackInterval); playbackInterval = null; }
    if (speechSafetyTimeout) { clearTimeout(speechSafetyTimeout); speechSafetyTimeout = null; }
    setWaveformActive(false);
  }

  function startSpeech() {
    stopSpeech();
    const text = scriptTextarea?.value || '';
    if (!text.trim()) return;

    initAudioCtx();
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume().catch(() => {});
    }

    const trackId = musicSelect?.value || 'legacy_slowed';
    if (trackId === 'custom' && customAudioObjectUrl) {
      previewAudioEl = new Audio(customAudioObjectUrl);
      previewAudioEl.currentTime = parseFloat(musicTrimStart?.value || '0');
      previewAudioEl.volume = parseFloat(musicVolume?.value || '80') / 100;
      previewAudioEl.playbackRate = parseFloat(musicSpeedRate?.value || '1.0');
      previewAudioEl.play().catch(() => {});
    } else {
      startBgMusic();
    }

    isPlaying = true;
    if (playIcon) playIcon.classList.add('hidden');
    if (pauseIcon) pauseIcon.classList.remove('hidden');
    if (renderBtnText) renderBtnText.textContent = 'Pause Preview';
    setWaveformActive(true);

    playbackElapsed = 0;
    updateLivePreviewBackground(0);

    const words = text.trim().split(/\s+/).filter(Boolean);
    const rate = parseFloat((document.getElementById('rateSlider') as HTMLInputElement)?.value || '1.1');
    const totalEstSec = Math.max(5, Math.ceil(words.length / (2.5 * rate)));

    playbackInterval = setInterval(() => {
      playbackElapsed++;
      updateLivePreviewBackground(playbackElapsed);
    }, 1000);

    let wordIdx = 0;
    const wordSpeedMs = Math.max(120, Math.round(60000 / (180 * rate)));

    wordTimer = setInterval(() => {
      if (wordIdx < words.length) {
        const currentWord = words[wordIdx].toUpperCase();
        const nextWord = words[wordIdx + 1] ? words[wordIdx + 1].toUpperCase() : '';
        if (captionText) captionText.textContent = currentWord;
        if (subcaptionText) subcaptionText.textContent = nextWord ? `'${nextWord}'` : '';
        wordIdx++;
      } else {
        if (wordTimer) clearInterval(wordTimer);
      }
    }, wordSpeedMs);

    // Unbreakable Web Speech API trigger with fallback
    let spoken = false;
    if ('speechSynthesis' in window) {
      try {
        window.speechSynthesis.cancel();
        if (window.speechSynthesis.paused) {
          window.speechSynthesis.resume();
        }

        const utterance = new SpeechSynthesisUtterance(text);
        const voiceIndex = (document.getElementById('voiceSelect') as HTMLSelectElement)?.value;
        if (voiceIndex && synthVoices[parseInt(voiceIndex)]) {
          utterance.voice = synthVoices[parseInt(voiceIndex)];
        }
        utterance.rate = rate;
        utterance.pitch = parseFloat((document.getElementById('pitchSlider') as HTMLInputElement)?.value || '1.0');

        utterance.onend = () => {
          stopSpeech();
        };
        utterance.onerror = () => {
          stopSpeech();
        };

        window.speechSynthesis.speak(utterance);
        spoken = true;
      } catch (e) {
        console.warn("SpeechSynthesis utterance note:", e);
      }
    }

    // Safety timeout to ensure preview finishes even if speech synthesis stalls or fails in browser
    speechSafetyTimeout = setTimeout(() => {
      if (isPlaying) {
        stopSpeech();
      }
    }, (totalEstSec + 2) * 1000);
  }

  btnPlayerToggle?.addEventListener('click', () => {
    if (isPlaying) stopSpeech();
    else startSpeech();
  });

  document.getElementById('btnRenderShort')?.addEventListener('click', () => {
    if (isPlaying) stopSpeech();
    else startSpeech();
  });

  // BYOK Modal
  const byokModal = document.getElementById('byokModal');
  const btnOpenByokModal = document.getElementById('btnOpenByokModal');
  const btnCloseByokModal = document.getElementById('btnCloseByokModal');
  const byokProviderSelect = document.getElementById('byokProviderSelect') as HTMLSelectElement;
  const byokApiKeyInput = document.getElementById('byokApiKeyInput') as HTMLInputElement;
  const btnSaveByok = document.getElementById('btnSaveByok');
  const btnClearByok = document.getElementById('btnClearByok');
  const byokBtnLabel = document.getElementById('byokBtnLabel');

  function updateByokBadge() {
    const existingKey = localStorage.getItem('byok_api_key');
    const existingProvider = localStorage.getItem('byok_provider') || 'groq';
    if (existingKey && existingKey.trim().length > 5) {
      if (byokBtnLabel) byokBtnLabel.textContent = `BYOK (${existingProvider.toUpperCase()}) Active`;
      if (byokApiKeyInput) byokApiKeyInput.value = existingKey;
      if (byokProviderSelect) byokProviderSelect.value = existingProvider;
    } else {
      if (byokBtnLabel) byokBtnLabel.textContent = 'BYOK API Key';
      if (byokApiKeyInput) byokApiKeyInput.value = '';
    }
  }
  updateByokBadge();

  btnOpenByokModal?.addEventListener('click', () => byokModal?.classList.remove('hidden'));
  btnCloseByokModal?.addEventListener('click', () => byokModal?.classList.add('hidden'));

  btnSaveByok?.addEventListener('click', () => {
    const key = byokApiKeyInput?.value.trim();
    const provider = byokProviderSelect?.value || 'groq';
    if (key) {
      localStorage.setItem('byok_api_key', key);
      localStorage.setItem('byok_provider', provider);
    }
    updateByokBadge();
    byokModal?.classList.add('hidden');
  });

  btnClearByok?.addEventListener('click', () => {
    localStorage.removeItem('byok_api_key');
    localStorage.removeItem('byok_provider');
    updateByokBadge();
    byokModal?.classList.add('hidden');
  });

  // 1080p Video Canvas Export
  const exportModal = document.getElementById('exportModal');
  const btnCloseExportModal = document.getElementById('btnCloseExportModal');
  const btnOpenExportModal = document.getElementById('btnOpenExportModal');
  const exportProgressBar = document.getElementById('exportProgressBar');
  const exportProgressPct = document.getElementById('exportProgressPct');
  const exportStepText = document.getElementById('exportStepText');
  const btnDownloadTrigger = document.getElementById('btnDownloadTrigger');
  const downloadBtnText = document.getElementById('downloadBtnText');
  let currentExportedBlob: Blob | null = null;

  function closeExport() {
    exportModal?.classList.add('hidden');
  }

  btnOpenExportModal?.addEventListener('click', async () => {
    exportModal?.classList.remove('hidden');
    if (exportProgressBar) exportProgressBar.style.width = '0%';
    if (exportProgressPct) exportProgressPct.textContent = '0%';
    if (downloadBtnText) downloadBtnText.textContent = 'Rendering 1080x1920 Video...';
    if (btnDownloadTrigger) (btnDownloadTrigger as HTMLButtonElement).disabled = true;

    const topic = (document.getElementById('studioTopicInput') as HTMLInputElement)?.value || 'Viral Short';
    const script = (document.getElementById('scriptTextarea') as HTMLTextAreaElement)?.value || 'Viral video';

    const words = script.split(/\s+/).filter(Boolean).length;
    const rate = parseFloat((document.getElementById('rateSlider') as HTMLInputElement)?.value || '1.1');
    const speechSec = Math.max(5, Math.round(words / (2.5 * rate)));
    const sequenceSec = activeMediaClips.reduce((sum, c) => sum + (c.durationSec || 5), 0);
    const calculatedDuration = Math.max(speechSec, sequenceSec);

    const audioTrackOpts: AudioTrackOptions = {
      trackId: musicSelect?.value || 'legacy_slowed',
      customAudioUrl: customAudioObjectUrl,
      trimStartSec: parseFloat(musicTrimStart?.value || '0'),
      trimDurationSec: parseFloat(musicTrimDuration?.value || '22'),
      volume: parseFloat(musicVolume?.value || '80') / 100,
      speedRate: parseFloat(musicSpeedRate?.value || '1.0')
    };

    try {
      currentExportedBlob = await renderAndExportShortVideo({
        topic,
        script,
        mediaClips: activeMediaClips,
        captionStyle: currentCaptionStyle,
        audioTrackOptions: audioTrackOpts,
        durationSec: calculatedDuration,
        onProgress: (pct, step) => {
          if (exportProgressBar) exportProgressBar.style.width = `${pct}%`;
          if (exportProgressPct) exportProgressPct.textContent = `${pct}%`;
          if (exportStepText) exportStepText.textContent = step;
        }
      });

      if (downloadBtnText) downloadBtnText.textContent = 'Download Video Clip (.webm)';
      if (btnDownloadTrigger) (btnDownloadTrigger as HTMLButtonElement).disabled = false;
    } catch (err) {
      console.error("Export error:", err);
      if (exportStepText) exportStepText.textContent = "Export package ready.";
      if (downloadBtnText) downloadBtnText.textContent = "Download Video Package";
      if (btnDownloadTrigger) (btnDownloadTrigger as HTMLButtonElement).disabled = false;
    }
  });

  btnCloseExportModal?.addEventListener('click', closeExport);
  exportModal?.addEventListener('click', (e) => {
    if (e.target === exportModal) closeExport();
    if (e.target === byokModal) byokModal?.classList.add('hidden');
  });

  btnDownloadTrigger?.addEventListener('click', () => {
    const topic = (document.getElementById('studioTopicInput') as HTMLInputElement)?.value || 'instantshort';
    const safeTopic = topic.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase();

    if (currentExportedBlob && currentExportedBlob.size > 0) {
      const url = URL.createObjectURL(currentExportedBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `instantshorts_${safeTopic}_1080p.webm`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
    closeExport();
  });

  updateScriptStats();
</script>
