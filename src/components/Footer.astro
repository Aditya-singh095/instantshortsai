---
---

<footer class="bg-[#fafafa] dark:bg-[#0c0c0c] border-t border-[#ebebeb] dark:border-[#262626] py-16 text-sm text-[#333333] dark:text-[#a1a1a1] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-[#ebebeb] dark:border-[#262626]">
      
      <!-- Brand Info (2 cols) -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5 group focus-visible:outline-2 focus-visible:outline-neutral-900 rounded-lg inline-flex" aria-label="Instant Shorts AI Home">
          <div class="w-7 h-7 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center font-mono font-bold text-xs transition-transform group-hover:scale-105">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.5 4.5l15 7.5-15 7.5v-15z" />
            </svg>
          </div>
          <span class="font-semibold text-base tracking-tight text-[#171717] dark:text-white">INSTANT SHORTS <span class="font-mono text-xs font-medium px-1.5 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200">AI</span></span>
        </a>

        <p class="text-xs text-[#525252] dark:text-[#888888] max-w-sm leading-relaxed">
          Open-source Viewmax alternative for YouTube Shorts, Instagram Reels, and TikTok automation. Zero paid API keys required.
        </p>

        <div class="flex items-center gap-2 text-xs font-mono text-[#525252] dark:text-[#888888]">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>System Status: All Engines Operational</span>
        </div>
      </div>

      <!-- Links Col 1 -->
      <div class="space-y-3">
        <div class="font-mono text-xs font-semibold text-[#171717] dark:text-white uppercase tracking-wider">Product</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#studio" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Interactive Studio</a></li>
          <li><a href="#engine" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">No-LLM Engine</a></li>
          <li><a href="#templates" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Viral Templates</a></li>
          <li><a href="#pricing" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Pricing Plans</a></li>
        </ul>
      </div>

      <!-- Links Col 2 -->
      <div class="space-y-3">
        <div class="font-mono text-xs font-semibold text-[#171717] dark:text-white uppercase tracking-wider">Niches</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#studio" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Stoicism & Philosophy</a></li>
          <li><a href="#studio" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Dark Space & Sci-Fi</a></li>
          <li><a href="#studio" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Wealth & Money Hacks</a></li>
          <li><a href="#studio" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Unsolved Mysteries</a></li>
        </ul>
      </div>

      <!-- Links Col 3 -->
      <div class="space-y-3">
        <div class="font-mono text-xs font-semibold text-[#171717] dark:text-white uppercase tracking-wider">Legal & Domain</div>
        <ul class="space-y-2 text-xs">
          <li><span class="font-mono text-[#525252] dark:text-[#888888]">instantshortsai.com</span></li>
          <li><a href="#faq" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Privacy & Data Policy</a></li>
          <li><a href="#faq" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Commercial Terms</a></li>
          <li><a href="#faq" class="hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Licensing & Rights</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#525252] dark:text-[#888888] font-mono gap-4">
      <div>© {new Date().getFullYear()} Instant Shorts AI (instantshortsai.com). All rights reserved.</div>
      <div class="flex items-center gap-4">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#171717] dark:hover:text-white focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">GitHub</a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#171717] dark:hover:text-white focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Twitter / X</a>
        <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#171717] dark:hover:text-white focus-visible:outline-2 focus-visible:outline-neutral-900 rounded">Discord</a>
      </div>
    </div>

  </div>
</footer>
