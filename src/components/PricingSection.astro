---

<section id="pricing" class="py-16 md:py-24 border-b border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#0c0c0c] relative transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="font-mono text-xs font-semibold tracking-widest text-[#525252] dark:text-[#a1a1a1] uppercase">
        SIMPLE TRANSPARENT PRICING
      </div>
      <h2 class="text-3xl md:text-5xl font-semibold text-[#171717] dark:text-white tracking-tight">
        Start Free. Upgrade As You Scale.
      </h2>
      <p class="text-[#4d4d4d] dark:text-[#a1a1a1] text-base sm:text-lg font-normal">
        No surprise API token bills. Choose the plan that fits your video automation goals.
      </p>
    </div>

    <!-- 3 Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      
      <!-- Free Plan -->
      <div class="bg-white dark:bg-[#111111] p-8 rounded-2xl border border-[#ebebeb] dark:border-[#262626] shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs uppercase font-semibold text-[#525252] dark:text-[#a1a1a1]">FREE FOREVER</span>
            <span class="px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-mono text-[10px] font-bold">No API Key Needed</span>
          </div>

          <div>
            <div class="text-4xl font-bold text-[#171717] dark:text-white">$0</div>
            <div class="text-xs text-[#525252] dark:text-[#a1a1a1] font-mono mt-1">Forever free for hobbyists & starters</div>
          </div>

          <hr class="border-[#ebebeb] dark:border-[#262626]" />

          <ul class="space-y-3 text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1]">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Unlimited script generation (Local Web-LLM)</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Web Speech AI Voiceovers</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>720p 9:16 Video Exports</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>MrBeast & Geist Subtitle Styles</span>
            </li>
          </ul>
        </div>

        <a href="#studio" class="w-full py-3 bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] hover:bg-neutral-50 dark:hover:bg-neutral-800 text-[#171717] dark:text-[#ededed] font-semibold text-sm rounded-full transition-all text-center block">
          Get Started Free
        </a>
      </div>

      <!-- Creator Pro Plan (Popular) -->
      <div class="bg-white dark:bg-[#111111] p-8 rounded-2xl border-2 border-neutral-900 dark:border-white shadow-xl flex flex-col justify-between space-y-6 relative">
        
        <!-- Popular Badge -->
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#171717] dark:bg-white text-white dark:text-black px-3 py-0.5 rounded-full font-mono text-[11px] font-semibold uppercase tracking-wider">
          MOST POPULAR FOR CREATORS
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs uppercase font-semibold text-violet-700 dark:text-violet-400">CREATOR PRO</span>
            <span class="px-2 py-0.5 rounded bg-violet-100 dark:bg-violet-950 text-violet-800 dark:text-violet-300 font-mono text-[10px] font-bold">Recommended</span>
          </div>

          <div>
            <div class="text-4xl font-bold text-[#171717] dark:text-white">$19 <span class="text-sm font-normal text-[#525252] dark:text-[#a1a1a1] font-mono">/ month</span></div>
            <div class="text-xs text-[#525252] dark:text-[#a1a1a1] font-mono mt-1">Everything needed for 1M+ views</div>
          </div>

          <hr class="border-[#ebebeb] dark:border-[#262626]" />

          <ul class="space-y-3 text-xs md:text-sm text-[#171717] dark:text-[#ededed]">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Everything in Free, plus:</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span><strong>1080p 60 FPS HD</strong> Video Exports</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span><strong>100+ Ultra-Realistic Neural Voices</strong></span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span><strong>Batch 30 Shorts</strong> in 1-Click</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Auto-Publish to YouTube, IG & TikTok</span>
            </li>
          </ul>
        </div>

        <a href="#studio" class="w-full py-3 bg-[#171717] dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-200 text-white dark:text-black font-semibold text-sm rounded-full transition-all text-center block shadow-md">
          Start Creator Pro Trial
        </a>
      </div>

      <!-- Agency Unlimited Plan -->
      <div class="bg-white dark:bg-[#111111] p-8 rounded-2xl border border-[#ebebeb] dark:border-[#262626] shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs uppercase font-semibold text-[#525252] dark:text-[#a1a1a1]">AGENCY UNLIMITED</span>
            <span class="px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 font-mono text-[10px] font-bold">Multi-Channel</span>
          </div>

          <div>
            <div class="text-4xl font-bold text-[#171717] dark:text-white">$49 <span class="text-sm font-normal text-[#525252] dark:text-[#a1a1a1] font-mono">/ month</span></div>
            <div class="text-xs text-[#525252] dark:text-[#a1a1a1] font-mono mt-1">For agency networks managing 10+ channels</div>
          </div>

          <hr class="border-[#ebebeb] dark:border-[#262626]" />

          <ul class="space-y-3 text-xs md:text-sm text-[#4d4d4d] dark:text-[#a1a1a1]">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Everything in Pro, plus:</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Unlimited Connected Social Accounts</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Custom Watermark & Brand Preset Engine</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Priority Cloud GPU Render Speed</span>
            </li>
          </ul>
        </div>

        <a href="#studio" class="w-full py-3 bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] hover:bg-neutral-50 dark:hover:bg-neutral-800 text-[#171717] dark:text-[#ededed] font-semibold text-sm rounded-full transition-all text-center block">
          Get Agency Plan
        </a>
      </div>

    </div>
  </div>
</section>
